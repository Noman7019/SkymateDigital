# Sky Mate Digital - SPA hosting on Hostinger (LiteSpeed/Apache)
Options -MultiViews
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Removed pages -> home (301)
  RewriteRule ^(pricing|careers|testimonials)/?$ / [R=301,L,NC]
  RewriteRule ^services/(media-buying|app-development|digital-marketing|seo-content-writing|website-development|automation-ai|website-maintenance)/?$ / [R=301,L,NC]

  # SPA fallback: any non-file, non-directory request -> index.html
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|webp|svg|gif|mp4|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
