# Sky Mate Digital - Hostinger (LiteSpeed/Apache + PHP)
Options -MultiViews -Indexes
DirectoryIndex api/render.php index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force https + apex domain
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  # Removed pages -> home (301)
  RewriteRule ^(pricing|careers|testimonials)/?$ / [R=301,L,NC]
  RewriteRule ^services/(media-buying|app-development|digital-marketing|seo-content-writing|website-development|automation-ai|website-maintenance)/?$ / [R=301,L,NC]

  # Trailing slash -> none (canonical URLs)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Never serve the server-side data folder if it falls back inside public_html
  RewriteRule ^api/data(/|$) - [F,L]

  # Dynamic SEO files
  RewriteRule ^sitemap\.xml$ api/sitemap.php [L]
  RewriteRule ^blog/rss\.xml$ api/rss.php [L]

  # Home page and every client route -> server-side SEO renderer (falls back to SPA shell)
  RewriteRule ^$ api/render.php [L]
  RewriteRule ^index\.html$ api/render.php [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . api/render.php [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "\.(png|jpe?g|webp|svg|gif|ico|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

# Compression (LiteSpeed also serves Brotli automatically when the client supports it)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json application/xml application/rss+xml image/svg+xml
</IfModule>
